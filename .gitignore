# --- Project data ---------------------------------------------------------
# Everything here is regenerable via src/fetch_data.py + src/build_network.py.
# data/raw/ holds the GTFS zip and the ~96 MB Nebraska OSM extract.
# data/processed/ holds the clipped .pbf and its .json sidecar, the destination
# grid, and the basemap tile cache. (The R5 network cache is NOT here: r5py writes
# it to %LOCALAPPDATA%\r5py and purges entries older than two weeks.)
data/raw/*
data/processed/

# MANIFEST.json IS tracked. It is the provenance record the published methodology
# cites -- source URLs, SHA-256 digests, and download timestamps for the exact inputs
# that produced the maps. Without it a rerun cannot be checked against the original.
# (Note the "data/raw/*" form above rather than "data/raw/": git will not descend into
# an ignored directory, so a negation inside one has no effect.)
!data/raw/MANIFEST.json

# data/origins.csv IS tracked -- it is curated input, not derived data.

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Jupyter --------------------------------------------------------------
.ipynb_checkpoints/

# --- r5py / R5 ------------------------------------------------------------
# r5py downloads the R5 jar and writes network caches next to its inputs.
*.jar
*.mapdb
*.mapdb.p
network.dat
r5py*.log

# --- Secrets / local config ----------------------------------------------
.env
*.local.yml

# --- OS / editors ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
